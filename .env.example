# Bản mẫu cấu hình chạy local — copy thành .env (đã bị .gitignore loại khỏi commit).
# Chạy:  npm ci  rồi  node --env-file=.env scan.js --dry-run
#
# Ghi chú: local dry-run KHÔNG cần DISPATCH_TOKEN (dry-run bỏ kiểm tra token,
# không ghi Firestore, không gọi Gemini — thuần đọc local để xem ứng viên).
# FIREBASE_SERVICE_ACCOUNT (chuỗi JSON inline) chỉ dùng trên GitHub Actions làm secret.

FIREBASE_SERVICE_ACCOUNT_FILE=./serviceAccount.json
TENANT_ID=tenant-demo
SOURCE_IDS="all"
LAST_HOURS=26
DRY_RUN=true
DISPATCH_TOKEN=
