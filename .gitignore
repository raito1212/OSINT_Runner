# Phụ thuộc cài bằng npm ci — không commit
node_modules/

# Cấu hình local chứa key/token
.env

# Key service account — TUYỆT ĐỐI không commit
serviceAccount*.json

# Log chạy thử local
*.log

# Ghi chú: KHÔNG thêm package-lock.json vào đây — lock file PHẢI commit
